CURLING_APP_ENV=local
CURLING_SYSTEM_CONFIG_PATH=config/system_config.json
CURLING_SITE_CONFIG_PATH=config/site_config.json
CURLING_SQLITE_PATH=data/db/curling.db
CURLING_LOG_PATH=data/logs/app.log
CURLING_FFMPEG_PATH=ffmpeg
CURLING_FFPROBE_PATH=ffprobe
APP_ENV=development
MOCK_MODE=false
PUBLIC_BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# Phase 7.0 冰壶 WebSocket 传输层配置，真实账号密码只放本地 .env，不提交 Git。
CURLING_WS_ENABLED=false
CURLING_API_BASE_URL=http://180.108.46.221:8922/wanghe
CURLING_WS_URL=ws://180.108.46.221:8922/wanghe/curlingWebSocket/{userId}
CURLING_LOGIN_PATH=/sys/mLogin
CURLING_USERNAME=
CURLING_PASSWORD=
CURLING_USER_ID=
CURLING_WS_RECONNECT_SECONDS=3
CURLING_WS_CONNECT_TIMEOUT_SECONDS=5

# Phase 7.1 定位缓存配置；只限制内存中每颗冰壶保留的最近点数。
CURLING_POSITION_CACHE_SIZE=20

# Phase 7.2 预投方向判断配置；freshness 使用服务端 received_at_ms，不使用设备 source_time。
# CURLING_POSITION_FRESHNESS_MS 表示方向预判所使用定位点允许的最大服务器接收年龄，单位毫秒。
CURLING_POSITION_FRESHNESS_MS=1000
# CURLING_DIRECTION_CONFIRM_COUNT 表示需要连续多少个定位点落在同一 Ready Zone 才锁定方向。
CURLING_DIRECTION_CONFIRM_COUNT=3
